From: quietvidarr <343052645+quietvidarr@users.noreply.github.com>
Date: Thu, 15 Oct 2026 09:19:36 +0200
Subject: [PATCH] 0006-router-17-32-rows-in-BLOCK_E-16-BK-128-tiles-bitwise

---
 src/tensorfold/cuda/moe.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/tensorfold/cuda/moe.py b/src/tensorfold/cuda/moe.py
index 2c7f2e3..ccc9882 100644
--- a/src/tensorfold/cuda/moe.py
+++ b/src/tensorfold/cuda/moe.py
@@ -48,6 +48,8 @@ def router(x: torch.Tensor, rows: torch.Tensor, out: torch.Tensor | None = None)
     bm = _tile(m)
     if bm == 16:
         be, bk, stages = 32, 256, 4
+    elif bm == 32:                               # 17-32 rows (several streams): more, shorter programs; same bits
+        be, bk, stages = 16, 128, 4
     else:
         be, bk, stages = 64, 64, 3               # Smaller K tiles keep prefill within shared-memory limits.
     grid = (triton.cdiv(m, bm), triton.cdiv(ne, be))
