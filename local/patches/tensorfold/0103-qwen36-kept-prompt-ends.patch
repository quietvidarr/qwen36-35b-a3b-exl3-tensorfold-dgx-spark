+class KeptEnds(PrefixCache):
+    """``PrefixCache`` whose cap drops a conversation's older states before any conversation's latest one.
+
+    Each turn adds 2-3 states (its message starts and its prompt end), and the plain rule (the oldest never resumed
+    from, else the oldest) let several conversations at once push each other's states out: none resumed. A state that
+    a newer one extends (an earlier point of the same conversation, or a shared system block) goes first, never
+    resumed ones before resumed ones, oldest first; then the plain rule over the latest states."""
+
+    def _drop(self, among: list) -> None:
+        def extended(entry) -> bool:
+            ids, n = entry[0], len(entry[0])
+            return n > 0 and any(len(o[0]) > n and o[0][n - 1] == ids[-1] and o[0][:n] == ids for o in self.entries)
+
+        older = [e for e in among if extended(e)]
+        if older:
+            cold = [e for e in older if tuple(e[0]) not in self.hit]
+            gone = cold[0] if cold else older[0]
+            self.entries = [e for e in self.entries if e is not gone]
+            self.hit &= {tuple(e[0]) for e in self.entries}
+            return
+        super()._drop(among)
+
