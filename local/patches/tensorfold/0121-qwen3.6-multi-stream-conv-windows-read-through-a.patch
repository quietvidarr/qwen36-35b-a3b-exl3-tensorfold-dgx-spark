From a77ddf6193a7eb0192a92362be9821e41a6025de Mon Sep 17 00:00:00 2001
From: quietvidarr <343052645+quietvidarr@users.noreply.github.com>
Date: Thu, 15 Oct 2026 09:19:36 +0200
Subject: [PATCH] 0008-qwen3.6-multi-stream-conv-windows-read-through-a-poi

---
 .../families/qwen3_5/cuda/forward.py          | 17 +++++++++---
 src/tensorfold/families/qwen3_5/cuda/glue.py  | 26 ++++++++++++-------
 2 files changed, 31 insertions(+), 12 deletions(-)

diff --git a/src/tensorfold/families/qwen3_5/cuda/forward.py b/src/tensorfold/families/qwen3_5/cuda/forward.py
index 3efbe18..eddacdc 100644
--- a/src/tensorfold/families/qwen3_5/cuda/forward.py
+++ b/src/tensorfold/families/qwen3_5/cuda/forward.py
@@ -16,6 +16,9 @@ from . import glue
 from .qmm_fast import matmul, matmul_group
 from .weights import Plain, QLinear, Weights
 
+# multi-stream forwards read each stream's conv window through a pointer table (TF_GDN_CONV_PTRS=0: concatenated)
+CONV_PTRS = __import__("os").environ.get("TF_GDN_CONV_PTRS", "1") != "0"
+
 
 def _mm(x: torch.Tensor, w: QLinear, xs: torch.Tensor | None = None) -> torch.Tensor:
     if not isinstance(w, QLinear):
@@ -338,7 +341,11 @@ def multi_tree_forward(w: Weights, streams: Sequence[tuple[Sequence[int], Sequen
     linear = [i for i, layer in enumerate(w.layers) if layer.linear]
     softmax = [i for i, layer in enumerate(w.layers) if not layer.linear]
     ptrs = [p for i in linear for p in deltanet.pointers([st.rec[i] for st in states])]
-    tables = dict(zip(linear, deltanet.to_device(ptrs, torch.int64, device).view(len(linear), len(states))))
+    if CONV_PTRS and len(states) > 1 and linear:   # each stream's conv window read in place (no per-layer cat)
+        ptrs += [p for i in linear for p in deltanet.pointers([st.conv[i] for st in states])]
+    dev_ptrs = deltanet.to_device(ptrs, torch.int64, device).view(-1, len(linear), len(states))
+    tables = dict(zip(linear, dev_ptrs[0]))
+    conv_tables = dict(zip(linear, dev_ptrs[1])) if dev_ptrs.shape[0] > 1 else {}
     aoffs = _cache_offsets(states, softmax, device)
     S = len(states)
     attn_flat, attn_items, attn_chunks = tree_attention.plan_host(local, [st.pos for st in states],
@@ -382,9 +389,13 @@ def multi_tree_forward(w: Weights, streams: Sequence[tuple[Sequence[int], Sequen
             else:
                 qkv, z, b, a = _mm_group(h, [gdn.qkv, gdn.z, gdn.b, gdn.a], xs)
                 z = z.reshape(W, c.v_heads, c.dv)
-            conv = states[0].conv[i] if S == 1 else torch.cat([st.conv[i] for st in states])
+            if i in conv_tables:
+                conv = states[0].conv[i]
+            else:
+                conv = states[0].conv[i] if S == 1 else torch.cat([st.conv[i] for st in states])
             q, k, v, g, beta = glue.gdn_pre(qkv, conv, gdn.conv, windows_t, a, b, gdn.A_log, gdn.dt_bias,
-                                            kh=c.k_heads, vh=c.v_heads, dk=c.dk, stream_ids=sid_t, nkeep=keep)
+                                            kh=c.k_heads, vh=c.v_heads, dk=c.dk, stream_ids=sid_t, nkeep=keep,
+                                            conv_table=conv_tables.get(i))
             yr = deltanet.tree(q, k, v, g, beta, plan, table=tables[i], pending=pend_args.get(i))
             out, out_xs = glue.gated_norm(yr, z, gdn.norm, c.eps)
             r = _row_mm(out, gdn.out, tp, out_xs)
diff --git a/src/tensorfold/families/qwen3_5/cuda/glue.py b/src/tensorfold/families/qwen3_5/cuda/glue.py
index 6f009a8..bb32a65 100644
--- a/src/tensorfold/families/qwen3_5/cuda/glue.py
+++ b/src/tensorfold/families/qwen3_5/cuda/glue.py
@@ -45,18 +45,24 @@ def add_rmsnorm(x: torch.Tensor, r: torch.Tensor | None, w: torch.Tensor, eps: f
 @triton.jit
 def _gdn_pre(QKV, CS, CW, WIN, A, B, ALOG, DTB, Q, K, V, G, BETA, SID,
              C: tl.constexpr, KH: tl.constexpr, VH: tl.constexpr, DK: tl.constexpr, NKEEP: tl.constexpr,
-             MULTI: tl.constexpr):
-    """Program (row, head): conv, SiLU, RMS-scaled q/k, plain v; ``MULTI``: row r's conv rows at CS[SID[r] * NKEEP]."""
+             MULTI: tl.constexpr, PTRS: tl.constexpr = False):
+    """Program (row, head): conv, SiLU, RMS-scaled q/k, plain v; ``MULTI``: row r's conv rows at CS[SID[r] * NKEEP]
+    (``PTRS``: CS is a table of each stream's conv-state address, row r's at CS[SID[r]])."""
 
     row = tl.program_id(0)
     head = tl.program_id(1)                   # 0..KH-1 q, KH..2KH-1 k, then VH v heads
     ch = head * DK + tl.arange(0, DK)
     acc = tl.zeros((DK,), dtype=tl.float32)
-    cs_row = tl.load(SID + row) * NKEEP if MULTI else 0
+    if PTRS:
+        cs = tl.load(CS + tl.load(SID + row)).to(tl.pointer_type(tl.bfloat16))
+        cs_row = 0
+    else:
+        cs = CS
+        cs_row = tl.load(SID + row) * NKEEP if MULTI else 0
     for j in tl.static_range(NKEEP + 1):
         src = tl.load(WIN + row * (NKEEP + 1) + j)
         from_state = src < NKEEP
-        xs = tl.load(CS + (cs_row + src) * C + ch, mask=(ch < C) & from_state, other=0.0)
+        xs = tl.load(cs + (cs_row + src) * C + ch, mask=(ch < C) & from_state, other=0.0)
         xw = tl.load(QKV + (src - NKEEP) * C + ch, mask=(ch < C) & (src >= NKEEP), other=0.0)
         x = tl.where(from_state, xs, xw).to(tl.float32)
         w = tl.load(CW + ch * (NKEEP + 1) + j).to(tl.float32)
@@ -86,11 +92,13 @@ def _gdn_pre(QKV, CS, CW, WIN, A, B, ALOG, DTB, Q, K, V, G, BETA, SID,
 
 def gdn_pre(qkv: torch.Tensor, conv_state: torch.Tensor, conv_w: torch.Tensor, windows: torch.Tensor,
             a: torch.Tensor, b: torch.Tensor, A_log: torch.Tensor, dt_bias: torch.Tensor, *, kh: int, vh: int, dk: int,
-            stream_ids: torch.Tensor | None = None, nkeep: int | None = None):
-    """windows (W, nkeep + 1) index [conv_state; qkv]; given ``stream_ids``, state indices are per stream."""
+            stream_ids: torch.Tensor | None = None, nkeep: int | None = None, conv_table: torch.Tensor | None = None):
+    """windows (W, nkeep + 1) index [conv_state; qkv]; given ``stream_ids``, state indices are per stream
+    (``conv_table``: int64 addresses of each stream's bf16 conv state, read in place instead of ``conv_state``)."""
 
     W, C = qkv.shape
     nkeep = conv_state.shape[0] if nkeep is None else nkeep
+    ptrs = conv_table is not None
     dev = qkv.device
     q = torch.empty((W, kh, dk), dtype=torch.bfloat16, device=dev)
     k = torch.empty((W, kh, dk), dtype=torch.bfloat16, device=dev)
@@ -98,9 +106,9 @@ def gdn_pre(qkv: torch.Tensor, conv_state: torch.Tensor, conv_w: torch.Tensor, w
     g = torch.empty((W, vh), dtype=torch.float32, device=dev)
     beta = torch.empty((W, vh), dtype=torch.float32, device=dev)
     multi = stream_ids is not None
-    _gdn_pre[(W, 2 * kh + vh)](qkv, conv_state, conv_w, windows, a, b, A_log, dt_bias, q, k, v, g, beta,
-                              stream_ids if multi else windows, C=C, KH=kh, VH=vh, DK=dk, NKEEP=nkeep, MULTI=multi,
-                              num_warps=2)
+    _gdn_pre[(W, 2 * kh + vh)](qkv, conv_table if ptrs else conv_state, conv_w, windows, a, b, A_log, dt_bias, q, k,
+                              v, g, beta, stream_ids if multi else windows, C=C, KH=kh, VH=vh, DK=dk, NKEEP=nkeep,
+                              MULTI=multi, PTRS=ptrs, num_warps=2)
     return q, k, v, g, beta
 
 
