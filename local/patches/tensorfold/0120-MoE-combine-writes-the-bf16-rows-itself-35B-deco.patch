From 17922d2b507c365915d29c73ebb0f80a770410a7 Mon Sep 17 00:00:00 2001
From: quietvidarr <343052645+quietvidarr@users.noreply.github.com>
Date: Thu, 15 Oct 2026 09:19:36 +0200
Subject: [PATCH] 0007-MoE-combine-writes-the-bf16-rows-itself-35B-decode-n

---
 src/tensorfold/cuda/exl3/experts.cpp             | 12 ++++++++----
 src/tensorfold/cuda/exl3/experts.cu              |  9 ++++++---
 src/tensorfold/cuda/exl3/experts.py              |  6 ++++--
 src/tensorfold/families/qwen3_5_moe/cuda/exl3.py |  6 +++---
 4 files changed, 21 insertions(+), 12 deletions(-)

diff --git a/src/tensorfold/cuda/exl3/experts.cpp b/src/tensorfold/cuda/exl3/experts.cpp
index 7936f89..7380ba5 100644
--- a/src/tensorfold/cuda/exl3/experts.cpp
+++ b/src/tensorfold/cuda/exl3/experts.cpp
@@ -24,7 +24,7 @@ void exl3x_combine_cuda(const at::Tensor&, const at::Tensor&, at::Tensor&, int64
 void exl3x_down_sum_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&, at::Tensor&,
                          int64_t, int64_t, int64_t, int64_t, int64_t, int64_t);
 void exl3x_down_combine_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, at::Tensor&, const at::Tensor&,
-                             at::Tensor&, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t);
+                             at::Tensor&, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, void*);
 
 static void check(const at::Tensor& x, at::ScalarType t, const char* name) {
     TORCH_CHECK(x.is_cuda() && x.scalar_type() == t && x.is_contiguous(), name,
@@ -204,7 +204,7 @@ void down_sum(const at::Tensor& Z, const at::Tensor& pick, const at::Tensor& svh
 
 void down_combine(const at::Tensor& Z, const at::Tensor& pick, const at::Tensor& svh_d, at::Tensor y,
                   const at::Tensor& wts, at::Tensor out, int64_t rows, int64_t P, int64_t D, int64_t SK, int64_t slots,
-                  int64_t E) {
+                  int64_t E, const c10::optional<at::Tensor>& out16) {
     check(Z, at::kFloat, "Z");
     check(pick, at::kInt, "pick");
     check(svh_d, at::kHalf, "svh_d");
@@ -213,7 +213,9 @@ void down_combine(const at::Tensor& Z, const at::Tensor& pick, const at::Tensor&
     check(out, at::kFloat, "out");
     TORCH_CHECK(D % 128 == 0, "D must be a multiple of 128");
     c10::cuda::CUDAGuard guard(Z.device());
-    exl3x_down_combine_cuda(Z, pick, svh_d, y, wts, out, rows, P, D, SK, slots, E);
+    if (out16) TORCH_CHECK(out16->is_cuda() && out16->scalar_type() == at::kBFloat16 && out16->is_contiguous() &&
+                           out16->numel() >= rows * D, "out16: bf16 [rows, D]");
+    exl3x_down_combine_cuda(Z, pick, svh_d, y, wts, out, rows, P, D, SK, slots, E, out16 ? out16->data_ptr() : nullptr);
 }
 
 PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
@@ -227,6 +229,8 @@ PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
     m.def("gateup_epilogue", &gateup_epilogue);
     m.def("down_epilogue", &down_epilogue);
     m.def("combine", &combine);
-    m.def("down_combine", &down_combine);
+    m.def("down_combine", &down_combine, py::arg("Z"), py::arg("pick"), py::arg("svh_d"), py::arg("y"), py::arg("wts"),
+          py::arg("out"), py::arg("rows"), py::arg("P"), py::arg("D"), py::arg("SK"), py::arg("slots"), py::arg("E"),
+          py::arg("out16") = py::none());
     m.def("down_sum", &down_sum);
 }
diff --git a/src/tensorfold/cuda/exl3/experts.cu b/src/tensorfold/cuda/exl3/experts.cu
index cc11bf8..26947d4 100644
--- a/src/tensorfold/cuda/exl3/experts.cu
+++ b/src/tensorfold/cuda/exl3/experts.cu
@@ -293,7 +293,7 @@ template <bool WY>
 __global__ void down_combine_kernel(const float* __restrict__ Z, const int* __restrict__ pick,
                                     const half* __restrict__ svh_d, float* __restrict__ y,
                                     const float* __restrict__ wts, float* __restrict__ out, int P, int D, int SK,
-                                    int E, int slots) {
+                                    int E, int slots, __nv_bfloat16* __restrict__ out16 = nullptr) {
     __shared__ float4 part[32][32];                 // [slot][lane]: the slot's 4 outputs of the lane
     const int r = blockIdx.x, blk = blockIdx.y;
     const int k = threadIdx.x >> 5, lane = threadIdx.x & 31;
@@ -333,6 +333,9 @@ __global__ void down_combine_kernel(const float* __restrict__ Z, const int* __re
     }
 #pragma unroll
     for (int j = 0; j < 4; ++j) out[(size_t)r * D + n + j] = acc[j];
+    if (out16 != nullptr)                           // the caller's bf16 rows: torch's round-to-nearest-even copy
+#pragma unroll
+        for (int j = 0; j < 4; ++j) out16[(size_t)r * D + n + j] = __float2bfloat16_rn(acc[j]);
 }
 
 }  // namespace
@@ -517,13 +520,13 @@ void exl3x_combine_cuda(const at::Tensor& y, const at::Tensor& wts, at::Tensor&
 
 void exl3x_down_combine_cuda(const at::Tensor& Z, const at::Tensor& pick, const at::Tensor& svh_d, at::Tensor& y,
                              const at::Tensor& wts, at::Tensor& out, int64_t rows, int64_t P, int64_t D, int64_t SK,
-                             int64_t slots, int64_t E) {
+                             int64_t slots, int64_t E, void* out16) {
     TORCH_CHECK(slots <= 32, "at most 32 slots a row");
     dim3 grid((unsigned)rows, (unsigned)(D / 128));
     down_combine_kernel<true><<<grid, (unsigned)(32 * slots), 0, at::cuda::getCurrentCUDAStream()>>>(
         Z.data_ptr<float>(), pick.data_ptr<int>(), reinterpret_cast<const half*>(svh_d.data_ptr()),
         y.data_ptr<float>(), wts.data_ptr<float>(), out.data_ptr<float>(), (int)P, (int)D, (int)SK, (int)E,
-        (int)slots);
+        (int)slots, reinterpret_cast<__nv_bfloat16*>(out16));
     C10_CUDA_KERNEL_LAUNCH_CHECK();
 }
 
diff --git a/src/tensorfold/cuda/exl3/experts.py b/src/tensorfold/cuda/exl3/experts.py
index 35f56ac..a34fbc2 100644
--- a/src/tensorfold/cuda/exl3/experts.py
+++ b/src/tensorfold/cuda/exl3/experts.py
@@ -189,7 +189,8 @@ def prompt_kernel_fits(ex: Exl3RoutedExperts) -> bool:
 
 def routed(x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor | None, ex: Exl3RoutedExperts, s: Scratch,
            out: torch.Tensor | None, R: int, limit: float = math.inf, act_mode: int = ACT_F32,
-           group: bool = True, prompt: bool = False, summed: bool = False) -> torch.Tensor:
+           group: bool = True, prompt: bool = False, summed: bool = False,
+           out16: torch.Tensor | None = None) -> torch.Tensor:
     """Routed experts of R rows (picks >= E skipped): Y per slot, or ``out`` = the wts-weighted sum when ``wts``; no host sync.
 
     ``prompt``: a prompt window through the prompt kernel (each decoded weight tile against every member of its
@@ -221,7 +222,8 @@ def routed(x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor | None, ex: Ex
     if out is None:
         out = torch.empty((R, D), dtype=torch.float32, device=x.device)
     # the down epilogue and the combine in one launch (the same arithmetic in the same order as the two)
-    ext.down_combine(s.z, pick, ex.svh_d, s.y, wts, out, R, P, D, sk, slots, E)
+    # ``out16``: the sum also as bf16 rows (torch's rounding), written by the same launch
+    ext.down_combine(s.z, pick, ex.svh_d, s.y, wts, out, R, P, D, sk, slots, E, out16)
     return out
 
 
diff --git a/src/tensorfold/families/qwen3_5_moe/cuda/exl3.py b/src/tensorfold/families/qwen3_5_moe/cuda/exl3.py
index 059d759..0e5b2c9 100644
--- a/src/tensorfold/families/qwen3_5_moe/cuda/exl3.py
+++ b/src/tensorfold/families/qwen3_5_moe/cuda/exl3.py
@@ -88,9 +88,9 @@ class Exl3Routed:
             moe.select_rows(b.logits[:n], b, self.top_k, self.count)
             if prompt:
                 routed(xr, b.pick[:n], b.wts[:n], self.experts, b.x3, b.out[:n], n, prompt=True, summed=True)
-            else:
-                routed(xr, b.pick[:n], b.wts[:n], self.experts, b.x3, b.out[:n], n)
-            out[r0:r0 + n].copy_(b.out[:n])
+                out[r0:r0 + n].copy_(b.out[:n])
+            else:                                        # the combine also writes the bf16 rows (no copy launch)
+                routed(xr, b.pick[:n], b.wts[:n], self.experts, b.x3, b.out[:n], n, out16=out[r0:r0 + n])
         return out
 
 
