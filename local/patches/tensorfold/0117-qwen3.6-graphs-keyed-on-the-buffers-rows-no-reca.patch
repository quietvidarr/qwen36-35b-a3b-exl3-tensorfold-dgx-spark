From: quietvidarr <343052645+quietvidarr@users.noreply.github.com>
Date: Thu, 15 Oct 2026 09:19:36 +0200
Subject: [PATCH] 0004-qwen3.6-graphs-keyed-on-the-buffers-rows-no-recaptur

---
 src/tensorfold/cuda/kernels/attention.py           | 12 +++++++++++-
 src/tensorfold/families/qwen3_5_moe/cuda/graphs.py | 11 ++++++++---
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/src/tensorfold/cuda/kernels/attention.py b/src/tensorfold/cuda/kernels/attention.py
index c98ca24..46913af 100644
--- a/src/tensorfold/cuda/kernels/attention.py
+++ b/src/tensorfold/cuda/kernels/attention.py
@@ -250,12 +250,22 @@ def plan_host(parents: Sequence[Sequence[int]], lengths: Sequence[int], group: i
     return rows + streams + items + glob, len(items) // 3, most
 
 
+def live_chunks(w: int, context: int) -> int:
+    """Chunk codes -1-j that any p <= context can run for a w-row window (``_shared`` runs chunk groups(p, w) * GROUP
+    + j iff its keys are all below p): the rest of a padded plan's chunk items would only exit."""
+
+    most = 0
+    for p in range(CHUNK, context + 1, CHUNK):           # p // CHUNK and groups(p, w) change only at multiples of CHUNK
+        most = max(most, p // CHUNK - groups(p, w) * GROUP)
+    return min(most, context // CHUNK)
+
+
 def padded_host(parents: Sequence[int], context: int, group: int) -> tuple[list[int], int, int]:
     """A graph includes all groups and chunks below its context; kernels skip items its keys do not fill."""
 
     flat, _, _ = plan_host([parents], [0], group)            # rows, the stream's row (refreshed per replay), parents
     w = len(parents)
-    codes = list(range(context // SPAN)) + [-1 - j for j in range(context // CHUNK)]
+    codes = list(range(context // SPAN)) + [-1 - j for j in range(live_chunks(w, context))]
     items = [x for code in codes for first in range(0, w * group, QUERY_TILE) for x in (0, first, code)]
     most = -(-(context + w) // CHUNK)                        # ``slots`` of any p <= context is at most this
     return flat[:w + 4] + items + flat[w + 4:], len(items) // 3, most
diff --git a/src/tensorfold/families/qwen3_5_moe/cuda/graphs.py b/src/tensorfold/families/qwen3_5_moe/cuda/graphs.py
index 0f769c3..88fe82b 100644
--- a/src/tensorfold/families/qwen3_5_moe/cuda/graphs.py
+++ b/src/tensorfold/families/qwen3_5_moe/cuda/graphs.py
@@ -11,7 +11,12 @@ from tensorfold.families.qwen3_5.cuda.forward import State, reserve, stage, tree
 
 from .mtp import Cache, Head, Staged as HeadStaged
 
-BUCKET = 8192        # smallest context span a graph covers; larger contexts take the next power of two
+import os
+
+BUCKET = 8192        # smallest buffer the graphs take; larger contexts grow it by powers of two (graphs recaptured)
+# graphs keyed on the buffers' capacity alone (one capture a width while the buffers keep their size); and the buffers'
+# rows taken at once (0: grown by powers of two as requests need), e.g. the slot capacity: never recaptured
+GRAPH_ROWS = int(os.environ.get("TF_QWEN36_GRAPH_ROWS", "0"))
 
 
 class Graphs:
@@ -25,13 +30,13 @@ class Graphs:
         self.mtp: dict[tuple[int, int], tuple] = {}
 
     def _bucket(self, end: int) -> int:
-        return min(self.rows, max(BUCKET, 1 << (end - 1).bit_length()))
+        return self.rows                                # padded plans skip what the keys don't fill
 
     def load(self, st: State, mc: Cache, need: int) -> tuple[State, Cache]:
         """A request's committed state and head cache in the fixed buffers, grown (graphs dropped) past ``need`` rows."""
 
         if need > self.rows:
-            self.rows = min(self.capacity, max(BUCKET, 1 << (need - 1).bit_length()))
+            self.rows = min(self.capacity, max(BUCKET, GRAPH_ROWS, 1 << (need - 1).bit_length()))
             self.target.clear()
             self.mtp.clear()
             self.st = self.mc = None
