From 24b1a75f4c5412f374a4fda5f23bd901189d93d0 Mon Sep 17 00:00:00 2001
From: quietvidarr <343052645+quietvidarr@users.noreply.github.com>
Date: Thu, 15 Oct 2026 09:19:36 +0200
Subject: [PATCH] 0005-grouped-experts-PF-3-4-instantiations-A-B-only

---
 src/tensorfold/cuda/exl3/experts_grouped.cuh | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/tensorfold/cuda/exl3/experts_grouped.cuh b/src/tensorfold/cuda/exl3/experts_grouped.cuh
index 57be4c0..6b62a87 100644
--- a/src/tensorfold/cuda/exl3/experts_grouped.cuh
+++ b/src/tensorfold/cuda/exl3/experts_grouped.cuh
@@ -336,6 +336,9 @@ void grouped_launch(const GroupedArgs& a, cudaStream_t stream) {
     if (a.nt == 8 && a.warps == 4 && a.pf == 1) { TF_RANGES(8, 4, 1) }
     else if (a.nt == 8 && a.warps == 4 && a.pf == 2) { TF_RANGES(8, 4, 2) }
     else if (a.nt == 4 && a.warps == 4 && a.pf == 2) { TF_RANGES(4, 4, 2) }
+    else if (a.nt == 8 && a.warps == 4 && a.pf == 3) { TF_RANGES(8, 4, 3) }
+    else if (a.nt == 8 && a.warps == 4 && a.pf == 4) { TF_RANGES(8, 4, 4) }
+    else if (a.nt == 4 && a.warps == 4 && a.pf == 4) { TF_RANGES(4, 4, 4) }
     else TORCH_CHECK(false, "unsupported tile setting nt=", a.nt, " warps=", a.warps, " pf=", a.pf);
 #undef TF_RANGES
 #undef TF_LAUNCH
