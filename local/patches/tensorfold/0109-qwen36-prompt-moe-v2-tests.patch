From 719d68dba740041d60b43591e4d1a5b9cda26de1 Mon Sep 17 00:00:00 2001
From: quietvidarr <343052645+quietvidarr@users.noreply.github.com>
Date: Thu, 15 Oct 2026 09:17:56 +0200
Subject: [PATCH] 0202-qwen36-prompt-moe-v2-tests

---
 tests/cuda/test_exl3_prompt_strips.py | 22 ++++++++++++++++------
 tests/cuda/test_qwen36_exl3_moe.py    | 22 +++++++++++++++++++---
 2 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/tests/cuda/test_exl3_prompt_strips.py b/tests/cuda/test_exl3_prompt_strips.py
index 6c1ab33..b8dbc7e 100644
--- a/tests/cuda/test_exl3_prompt_strips.py
+++ b/tests/cuda/test_exl3_prompt_strips.py
@@ -45,7 +45,12 @@ def test_narrow_prompt_matches_grouped(R, k2s):
     got = X.routed(x, pick, None, ex, s, None, R, prompt=True).clone()
     assert not torch.isnan(got).any()
     assert ((got - ref).abs().max() / ref.abs().max()).item() < 2e-3
-    assert ((got - ref).norm() / ref.norm()).item() < 1e-4
+    # lab patch 0201: the second-generation prompt kernel is as close to the exact result as the grouped one
+    from test_exl3_prompt_experts import reference
+    exact = reference(ex, x, pick).view(R * (top + 1), D)
+    e_prompt = ((got.double() - exact).norm() / exact.norm()).item()
+    e_grouped = ((ref.double() - exact).norm() / exact.norm()).item()
+    assert e_prompt < 1.05 * e_grouped + 1e-6, f"prompt kernel {e_prompt:.3e} vs grouped {e_grouped:.3e} from exact"
 
 
 def test_narrow_rows_independent_of_window():
@@ -56,9 +61,14 @@ def test_narrow_rows_independent_of_window():
     wts = torch.rand((R, top + 1), device="cuda", generator=g)
     x = (0.5 * torch.randn((R, D), device="cuda", generator=g)).bfloat16()
     s = X.Scratch(ex, R, top + 1)
-    whole = torch.empty((R, D), dtype=torch.float32, device="cuda")
-    X.routed(x, pick, wts, ex, s, whole, R, prompt=True, summed=True)
-    part = torch.empty((200, D), dtype=torch.float32, device="cuda")
-    X.routed(x[100:300].contiguous(), pick[100:300].contiguous(), wts[100:300].contiguous(), ex, s, part, 200,
-             prompt=True, summed=True)
+    det = X.PROMPT_DET
+    X.PROMPT_DET = True                               # the fixed slot order (lab patch 0201's default adds them freely)
+    try:
+        whole = torch.empty((R, D), dtype=torch.float32, device="cuda")
+        X.routed(x, pick, wts, ex, s, whole, R, prompt=True, summed=True)
+        part = torch.empty((200, D), dtype=torch.float32, device="cuda")
+        X.routed(x[100:300].contiguous(), pick[100:300].contiguous(), wts[100:300].contiguous(), ex, s, part, 200,
+                 prompt=True, summed=True)
+    finally:
+        X.PROMPT_DET = det
     assert torch.equal(whole[100:300], part)          # bit for bit
diff --git a/tests/cuda/test_qwen36_exl3_moe.py b/tests/cuda/test_qwen36_exl3_moe.py
index 4d3bdef..23eb12c 100644
--- a/tests/cuda/test_qwen36_exl3_moe.py
+++ b/tests/cuda/test_qwen36_exl3_moe.py
@@ -42,10 +42,19 @@ def test_verify_rows_independent_of_window():
 def test_prompt_rows_independent_of_window_and_close_to_decode():
     from tensorfold.cuda import moe
 
+    from tensorfold.cuda.exl3 import experts as X
+
     m, g = _routed()
     x = torch.randn((3000, 2048), device="cuda", generator=g).bfloat16()
-    prompt = moe.run(x, m, prefill=True)
-    assert torch.equal(moe.run(x[1000:2500].contiguous(), m, prefill=True), prompt[1000:2500])
+    det = X.PROMPT_DET
+    X.PROMPT_DET = True                               # the fixed slot order (lab patch 0201's default adds them freely)
+    try:
+        prompt = moe.run(x, m, prefill=True)
+        assert torch.equal(moe.run(x[1000:2500].contiguous(), m, prefill=True), prompt[1000:2500])
+    finally:
+        X.PROMPT_DET = det
+    free = moe.run(x, m, prefill=True)                # bf16 roundings of fp32 sums in another order: rare 1-ulp flips
+    assert ((free.float() - prompt.float()).abs() > 0).float().mean().item() < 0.02
     decode = moe.run(x[:128].contiguous(), m)
     rel = ((prompt[:128].float() - decode.float()).norm() / decode.float().norm()).item()
     assert rel < 5e-3, f"prompt and decode kernels differ by {rel:.2e}"
@@ -54,6 +63,13 @@ def test_prompt_rows_independent_of_window_and_close_to_decode():
 def test_head_takes_prompt_kernel_for_wide_rows():
     from tensorfold.cuda import moe
 
+    from tensorfold.cuda.exl3 import experts as X
+
     m, g = _routed(wide_prompt=True)
     x = torch.randn((600, 2048), device="cuda", generator=g).bfloat16()
-    assert torch.equal(moe.run(x, m), moe.run(x, m, prefill=True))
+    det = X.PROMPT_DET
+    X.PROMPT_DET = True                               # the fixed slot order (lab patch 0201's default adds them freely)
+    try:
+        assert torch.equal(moe.run(x, m), moe.run(x, m, prefill=True))
+    finally:
+        X.PROMPT_DET = det
-- 
